# ==========================================
# Apple Music API & MusicKit JS Configuration
# ==========================================
# 1. APPLE_TEAM_ID: Apple Developer Account 10-character Team ID (found in developer.apple.com top right).
# 2. APPLE_KEY_ID: 10-character Key ID from Keys section (Certificates, Identifiers & Profiles > Keys).
# 3. APPLE_PRIVATE_KEY: The contents of the downloaded .p8 private key file.
#    In .env.local, replace literal newlines with \n or enclose within double quotes.

APPLE_TEAM_ID=XXXXXXXXXX
APPLE_KEY_ID=XXXXXXXXXX
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIGTAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBHkwdwIBAQQg...\n-----END PRIVATE KEY-----"
