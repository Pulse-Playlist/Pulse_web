# Apple MusicKit JS v3 Developer Credentials
# Obtain from Apple Developer Portal -> Certificates, Identifiers & Profiles -> Keys (MusicKit)
APPLE_TEAM_ID=YOUR_10_CHAR_TEAM_ID
APPLE_KEY_ID=YOUR_10_CHAR_KEY_ID
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_P8_PRIVATE_KEY_CONTENTS_HERE\n-----END PRIVATE KEY-----"

# Supabase Configuration (Publishable & Secret API Keys)
SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
SUPABASE_SECRET_KEY=sb_secret_your_key_here
